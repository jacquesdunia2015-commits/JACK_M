# Copier en .env puis adapter
DATABASE_URL=postgres://locagest:locagest@localhost:5432/locagest
JWT_SECRET=changez-moi-par-une-longue-chaine-aleatoire
PORT=4000
# Fuseau utilisé pour « aujourd'hui » dans le calcul des alertes
APP_TIMEZONE=Africa/Kinshasa
# Adresse publique de l'application (liens dans les emails)
APP_URL=http://localhost:5173
# Emails (SMTP : Brevo, SendGrid, Gmail…). Sans SMTP_HOST, les emails sont
# simulés : écrits dans la console et marqués « simulé » dans l'historique.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="LocaGest <no-reply@locagest.app>"
# Compte administrateur créé au démarrage s'il n'existe pas
ADMIN_EMAIL=admin@locagest.app
ADMIN_PASSWORD=
# Dossier de stockage des photos
UPLOAD_DIR=uploads
# Derrière un proxy (Nginx, Render…) : 1 pour lire l'IP du visiteur dans X-Forwarded-For.
# Sur Render, c'est automatique.
TRUST_PROXY=
