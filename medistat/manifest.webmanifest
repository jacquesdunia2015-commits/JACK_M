{
  "id": "/medistat/",
  "name": "MediStat — Dossiers médicaux, laboratoire et analyse de données",
  "short_name": "MediStat",
  "description": "Gestion des dossiers médicaux et des résultats de laboratoire, avec analyse statistique des données quantitatives et qualitatives. Fonctionne hors ligne, sur ordinateur comme sur téléphone.",
  "lang": "fr",
  "dir": "ltr",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#17334f",
  "theme_color": "#17334f",
  "categories": ["medical", "health", "productivity", "utilities"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": "focus-existing" },
  "icons": [
    { "src": "./assets/icone-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./assets/icone-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./assets/icone-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Tableau de bord",
      "short_name": "Bord",
      "description": "Indicateurs d'activité de l'établissement",
      "url": "./index.html#/tableau-de-bord",
      "icons": [{ "src": "./assets/icone-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Paillasse",
      "short_name": "Paillasse",
      "description": "Analyses en attente de saisie",
      "url": "./index.html#/paillasse",
      "icons": [{ "src": "./assets/icone-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Validation des résultats",
      "short_name": "Validation",
      "description": "Résultats en attente de validation biologique",
      "url": "./index.html#/validation",
      "icons": [{ "src": "./assets/icone-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Analyses statistiques",
      "short_name": "Analyse",
      "description": "Statistiques descriptives et inférentielles",
      "url": "./index.html#/statistiques",
      "icons": [{ "src": "./assets/icone-192.png", "sizes": "192x192" }]
    }
  ]
}
