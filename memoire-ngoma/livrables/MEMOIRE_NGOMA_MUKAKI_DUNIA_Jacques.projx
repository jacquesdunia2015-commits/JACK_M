      "docId": "s0018h",
      "codeId": "s0000d",
      "start": 5233,
      "end": 5290,
      "text": "Je réfère par écrit sur le carnet. Je n'ai pas de retour.",
      "weight": 1,
      "comment": "",
      "created": "2026-09-20T09:00:00.000Z",
      "coder": "C1"
    },
    {
