    },
    {
      "id": "s001zk",
      "docId": "s0011e",
      "codeId": "s0001x",
      "start": 6848,
      "end": 7032,
      "text": "Celles des collines en saison des pluies. Et celles dont la famille préfère le guérisseur — non pas parce qu'elles refusent, mais parce que la décision ne leur appartient pas toujours.",
      "weight": 1,
      "comment": "",
      "created": "2026-09-20T09:00:00.000Z",
      "coder": "C1b"
    },
    {
      "id": "s001zl",
      "docId": "s0011e",
      "codeId": "s0001f",
      "start": 7167,
      "end": 7368,
      "text": "Confirmer, référer, appeler l'ambulance, et en saison des pluies trouver par où la faire descendre. Mon rôle va jusqu'à la route goudronnée, souvent. Après, je n'ai pas de retour, sauf si je téléphone.",
      "weight": 1,
      "comment": "",
      "created": "2026-09-20T09:00:00.000Z",
      "coder": "C1b"
    },
    {
      "id": "s001zm",
      "docId": "s0011e",
      "codeId": "s0001p",
      "start": 7167,
      "end": 7368,
      "text": "Confirmer, référer, appeler l'ambulance, et en saison des pluies trouver par où la faire descendre. Mon rôle va jusqu'à la route goudronnée, souvent. Après, je n'ai pas de retour, sauf si je téléphone.",
      "weight": 1,
