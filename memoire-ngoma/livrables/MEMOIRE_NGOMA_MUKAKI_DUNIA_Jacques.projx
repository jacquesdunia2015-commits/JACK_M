      "coder": "C1"
    },
    {
      "id": "s001ep",
      "docId": "s001ct",
      "codeId": "s00024",
      "start": 8246,
      "end": 8327,
      "text": "Des moyens, et de notre regard. Le regard, c'est ce que je peux changer moi-même.",
      "weight": 1,
      "comment": "",
      "created": "2026-09-20T09:00:00.000Z",
      "coder": "C1"
    },
    {
      "id": "s001eq",
