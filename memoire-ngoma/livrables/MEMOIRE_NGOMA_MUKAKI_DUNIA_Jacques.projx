    },
    {
      "id": "s001d6",
      "docId": "s001ct",
      "codeId": "s0000d",
      "start": 2611,
      "end": 2660,
      "text": "Une y est allée. Les deux autres, je ne sais pas.",
      "weight": 1,
      "comment": "",
      "created": "2026-09-20T09:00:00.000Z",
      "coder": "C1"
    },
    {
      "id": "s001d7",
      "docId": "s001ct",
