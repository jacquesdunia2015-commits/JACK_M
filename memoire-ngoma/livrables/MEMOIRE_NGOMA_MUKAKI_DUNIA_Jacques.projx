      "coder": "C1"
    },
    {
      "id": "s00199",
      "docId": "s0018h",
      "codeId": "s0000z",
      "start": 3908,
      "end": 3989,
      "text": "Le matériel neuf, quand il est là, et le temps, puisque nous avons peu de femmes.",
      "weight": 1,
      "comment": "",
      "created": "2026-09-20T09:00:00.000Z",
      "coder": "C1"
    },
    {
