      "coder": "C1"
    },
    {
      "id": "s0030n",
      "docId": "s002zv",
      "codeId": "s0021p",
      "start": 3741,
      "end": 3827,
      "text": "Avoir une collègue expérimentée à qui demander. Quand elle est là, je suis tranquille.",
