      "comment": "",
      "created": "2026-10-01T09:00:00.000Z",
      "coder": "C1"
    },
    {
      "id": "s0030m",
      "docId": "s002zv",
      "codeId": "s00211",
      "start": 3568,
      "end": 3610,
      "text": "Oui, je pense. On me l'a appris à l'école.",
