    },
    {
      "id": "s003z4",
      "docId": "s003a7",
      "codeId": "s00219",
      "start": 5751,
      "end": 5827,
      "text": "Confirmer, référer, appeler l'hôpital si c'est grave. Mon rôle va jusque-là.",
      "weight": 1,
      "comment": "",
      "created": "2026-10-01T09:00:00.000Z",
      "coder": "C2"
    },
    {
      "id": "s003z5",
