      "codeId": "s0012c",
      "start": 6562,
      "end": 6654,
      "text": "La formation de 2023. Et l'équipe : nous nous sommes formées entre nous, en nous corrigeant.",
      "weight": 1,
      "comment": "",
      "created": "2026-10-01T09:00:00.000Z",
      "coder": "C1"
    },
    {
      "id": "s001ka",
