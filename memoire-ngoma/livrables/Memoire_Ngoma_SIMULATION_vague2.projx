      "docId": "s001ex",
      "codeId": "s0012c",
      "start": 3780,
      "end": 3861,
      "text": "Le matériel neuf, quand il est là, et le temps, puisque nous avons peu de femmes.",
      "weight": 1,
      "comment": "",
      "created": "2026-10-01T09:00:00.000Z",
      "coder": "C1"
    },
