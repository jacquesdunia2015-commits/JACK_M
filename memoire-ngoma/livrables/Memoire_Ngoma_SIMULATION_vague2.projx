      "coder": "C1"
    },
    {
      "id": "s001fv",
      "docId": "s001ex",
      "codeId": "s0012i",
      "start": 4202,
      "end": 4390,
      "text": "La dotation arrive par morceaux. Le bâtiment d'abord, puis le mobilier, puis l'équipement de base. Les consommables et les registres viennent en dernier. On nous dit que tout est commandé.",
      "weight": 1,
      "comment": "",
      "created": "2026-10-01T09:00:00.000Z",
      "coder": "C1"
    },
    {
      "id": "s001fw",
      "docId": "s001ex",
      "codeId": "s0012v",
      "start": 4202,
      "end": 4390,
      "text": "La dotation arrive par morceaux. Le bâtiment d'abord, puis le mobilier, puis l'équipement de base. Les consommables et les registres viennent en dernier. On nous dit que tout est commandé.",
      "weight": 1,
      "comment": "",
      "created": "2026-10-01T09:00:00.000Z",
      "coder": "C1"
    },
    {
