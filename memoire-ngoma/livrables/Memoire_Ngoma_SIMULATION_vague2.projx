      "coder": "C1"
    },
    {
      "id": "s001jj",
      "docId": "s001ir",
      "codeId": "s0011o",
      "start": 3910,
      "end": 3931,
      "text": "Oui, sans discussion.",
      "weight": 1,
      "comment": "",
      "created": "2026-10-01T09:00:00.000Z",
      "coder": "C1"
    },
    {
      "id": "s001jk",
      "docId": "s001ir",
      "codeId": "s0012c",
      "start": 4062,
      "end": 4222,
      "text": "L'équipe stable, la formation de 2023, l'appareil qui fonctionne. Et la vérification de la compréhension : faire répéter, ça prend une minute et ça change tout.",
      "weight": 1,
      "comment": "",
      "created": "2026-10-01T09:00:00.000Z",
      "coder": "C1"
    },
    {
