    },
    {
      "id": "s001oa",
      "docId": "s001mt",
      "codeId": "s0013f",
      "start": 6008,
      "end": 6215,
      "text": "(silence) Normal… Ce n'est pas bien, mais c'est la vie ici. On fait ce qu'on peut avec ce qu'on a. Les choses changent lentement. J'ai vu pire, quand j'ai commencé : il n'y avait même pas d'appareil du tout.",
      "weight": 1,
      "comment": "",
      "created": "2026-10-01T09:00:00.000Z",
      "coder": "C1"
    },
    {
      "id": "s001ob",
      "docId": "s001mt",
      "codeId": "s0013c",
      "start": 6262,
      "end": 6361,
      "text": "Parce qu'en trente ans, j'ai vu que s'inquiéter ne change rien. On mesure, on réfère, et on espère.",
      "weight": 1,
      "comment": "",
      "created": "2026-10-01T09:00:00.000Z",
      "coder": "C1"
    },
    {
      "id": "s001oc",
      "docId": "s001mt",
      "codeId": "s0013e",
      "start": 6262,
      "end": 6361,
      "text": "Parce qu'en trente ans, j'ai vu que s'inquiéter ne change rien. On mesure, on réfère, et on espère.",
      "weight": 1,
      "comment": "",
      "created": "2026-10-01T09:00:00.000Z",
      "coder": "C1"
    },
    {
      "id": "s001od",
      "docId": "s001mt",
      "codeId": "s0013f",
      "start": 6262,
      "end": 6361,
      "text": "Parce qu'en trente ans, j'ai vu que s'inquiéter ne change rien. On mesure, on réfère, et on espère.",
      "weight": 1,
      "comment": "",
      "created": "2026-10-01T09:00:00.000Z",
      "coder": "C1"
    },
    {
      "id": "s001oe",
      "docId": "s001mt",
      "codeId": "s0013c",
      "start": 6406,
      "end": 6458,
      "text": "De l'argent du pays, du matériel, et un peu de Dieu.",
      "weight": 1,
      "comment": "",
      "created": "2026-10-01T09:00:00.000Z",
      "coder": "C1"
    },
    {
      "id": "s001of",
      "docId": "s001mt",
      "codeId": "s0013e",
      "start": 6406,
      "end": 6458,
      "text": "De l'argent du pays, du matériel, et un peu de Dieu.",
      "weight": 1,
      "comment": "",
      "created": "2026-10-01T09:00:00.000Z",
      "coder": "C1"
    },
    {
      "id": "s001og",
      "docId": "s001mt",
      "codeId": "s0013f",
      "start": 6406,
      "end": 6458,
      "text": "De l'argent du pays, du matériel, et un peu de Dieu.",
      "weight": 1,
      "comment": "",
      "created": "2026-10-01T09:00:00.000Z",
      "coder": "C1"
    },
    {
      "id": "s001oh",
      "docId": "s001mt",
      "codeId": "s0011q",
      "start": 6601,
      "end": 6641,
      "text": "Non. Formez bien les jeunes, c'est tout.",
      "weight": 1,
      "comment": "",
      "created": "2026-10-01T09:00:00.000Z",
      "coder": "C1"
    },
    {
      "id": "s001oi",
      "docId": "s001mt",
      "codeId": "s0013n",
      "start": 6601,
      "end": 6641,
      "text": "Non. Formez bien les jeunes, c'est tout.",
      "weight": 1,
      "comment": "",
