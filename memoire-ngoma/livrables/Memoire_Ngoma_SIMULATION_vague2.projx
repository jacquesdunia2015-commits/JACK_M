    },
    {
      "id": "s001q9",
      "docId": "s001ok",
      "codeId": "s0012b",
      "start": 6287,
      "end": 6393,
      "text": "Pas de formation. J'ai appris avec les cas, et en appelant une amie sage-femme à l'hôpital quand je doute.",
      "weight": 1,
      "comment": "",
      "created": "2026-10-01T09:00:00.000Z",
      "coder": "C1"
    },
    {
      "id": "s001qa",
