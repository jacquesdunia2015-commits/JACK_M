      "docId": "s001gp",
      "codeId": "s0011q",
      "start": 7933,
      "end": 8063,
      "text": "Oui : les femmes de passage. Je ne crois pas qu'on en parle beaucoup, et pourtant chez nous ce sont peut-être un tiers des femmes.",
