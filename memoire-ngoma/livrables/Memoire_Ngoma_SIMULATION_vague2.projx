    {
      "id": "s001ry",
      "docId": "s001ro",
      "codeId": "s0013v",
      "start": 2465,
      "end": 2718,
      "text": "Affluence la plus faible des centres ruraux observés. L'équipe explique que la route d'accès devient impraticable en saison des pluies et que la fréquentation chute alors fortement. Une femme arrive à pied après, dit-elle, plus de deux heures de marche.",
      "weight": 1,
      "comment": "",
      "created": "2026-10-01T09:00:00.000Z",
      "coder": "C1"
    },
    {
      "id": "s001rz",
      "docId": "s001ro",
      "codeId": "s0012h",
      "start": 2465,
      "end": 2718,
      "text": "Affluence la plus faible des centres ruraux observés. L'équipe explique que la route d'accès devient impraticable en saison des pluies et que la fréquentation chute alors fortement. Une femme arrive à pied après, dit-elle, plus de deux heures de marche.",
      "weight": 1,
