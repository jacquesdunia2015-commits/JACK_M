      "coder": "C1"
    },
    {
      "id": "s001l0",
      "docId": "s001ks",
      "codeId": "s0011w",
      "start": 2038,
      "end": 2320,
      "text": "Une femme de trente-sept ans, sixième grossesse, venue à trente-quatre semaines pour un premier contact, tension à 172 sur 110 et des protéines. Référée en urgence, elle a été prise en charge. Celle-là, on ne pouvait pas la manquer : elle avait mal à la tête et les jambes gonflées.",
      "weight": 1,
      "comment": "",
      "created": "2026-10-01T09:00:00.000Z",
      "coder": "C1"
    },
    {
      "id": "s001l1",
      "docId": "s001ks",
      "codeId": "s0012s",
      "start": 2038,
      "end": 2320,
      "text": "Une femme de trente-sept ans, sixième grossesse, venue à trente-quatre semaines pour un premier contact, tension à 172 sur 110 et des protéines. Référée en urgence, elle a été prise en charge. Celle-là, on ne pouvait pas la manquer : elle avait mal à la tête et les jambes gonflées.",
