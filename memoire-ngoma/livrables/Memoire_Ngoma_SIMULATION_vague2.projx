      "id": "s001l3",
      "docId": "s001ks",
      "codeId": "s0011w",
      "start": 2359,
      "end": 2430,
      "text": "C'est là que le problème se pose. Je vais y revenir, si vous permettez.",
      "weight": 1,
      "comment": "",
      "created": "2026-10-01T09:00:00.000Z",
      "coder": "C1"
    },
    {
      "id": "s001l4",
      "docId": "s001ks",
      "codeId": "s0012s",
      "start": 2359,
      "end": 2430,
      "text": "C'est là que le problème se pose. Je vais y revenir, si vous permettez.",
      "weight": 1,
      "comment": "",
