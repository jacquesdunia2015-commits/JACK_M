    },
    {
      "id": "s001qb",
      "docId": "s001ok",
      "codeId": "s0012k",
      "start": 6520,
      "end": 6731,
      "text": "Le district vient rarement, c'est loin. Quand ils viennent, ils regardent les registres officiels. Le cahier de suivi, je leur ai montré : ils ont dit que c'était bien, mais que ce n'était pas un outil officiel.",
      "weight": 1,
      "comment": "",
      "created": "2026-10-01T09:00:00.000Z",
      "coder": "C1"
    },
    {
      "id": "s001qc",
      "docId": "s001ok",
      "codeId": "s0012u",
      "start": 6520,
      "end": 6731,
      "text": "Le district vient rarement, c'est loin. Quand ils viennent, ils regardent les registres officiels. Le cahier de suivi, je leur ai montré : ils ont dit que c'était bien, mais que ce n'était pas un outil officiel.",
      "weight": 1,
      "comment": "",
