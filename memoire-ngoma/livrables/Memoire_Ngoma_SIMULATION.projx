    },
    {
      "id": "s000f0",
      "docId": "s000eg",
      "codeId": "s0000r",
      "start": 2806,
      "end": 2976,
      "text": "(silence) C'est frustrant. J'ai la connaissance et je n'ai pas l'outil. C'est comme apprendre à conduire et ne pas avoir de voiture. Et avec le temps j'ai peur d'oublier.",
      "weight": 1,
