      "id": "s000de",
      "docId": "s000c5",
      "codeId": "s0000x",
      "start": 6183,
      "end": 6293,
      "text": "Il est au centre. Parfois le curatif l'utilise. Alors on attend un moment. Mais on finit toujours par mesurer.",
      "weight": 1,
      "comment": "",
      "created": "2026-09-20T09:00:00.000Z",
