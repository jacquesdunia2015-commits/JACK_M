      "coder": "C1"
    },
    {
      "id": "s0003g",
      "docId": "s0002a",
      "codeId": "s0000x",
      "start": 8839,
      "end": 9003,
      "text": "L'approvisionnement. On commande, ça vient en petite quantité, ou ça ne vient pas. Je ne sais pas si c'est le district ou plus haut. Nous, on remplit les commandes.",
      "weight": 1,
      "comment": "",
      "created": "2026-09-20T09:00:00.000Z",
      "coder": "C1"
    },
    {
      "id": "s0003h",
      "docId": "s0002a",
      "codeId": "s00018",
      "start": 8839,
      "end": 9003,
      "text": "L'approvisionnement. On commande, ça vient en petite quantité, ou ça ne vient pas. Je ne sais pas si c'est le district ou plus haut. Nous, on remplit les commandes.",
      "weight": 1,
      "comment": "",
