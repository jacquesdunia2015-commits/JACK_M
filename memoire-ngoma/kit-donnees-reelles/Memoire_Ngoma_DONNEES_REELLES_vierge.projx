  "memos": [
    {
      "id": "r00007",
      "targetType": "code",
      "targetId": "r00003",
      "created": "2026-10-03T02:09:25.565Z",
      "title": "Définition — 1. Sens attribué au dépistage",
      "text": "Concept (Tableau III) : Sens attribué\nDéfinition retenue : Signification et valeur conférées au dépistage dans le cadre de la CPN\nDimensions explorées : Utilité perçue pour la femme ; légitimité au regard du mandat ; priorité face aux autres tâches\nManifestations attendues : Justifications spontanées ; comparaisons avec d'autres actes ; adhésion ou réserve\nSource : Guide, axe 1 (Q7, Q8)\n\nCodes inductifs : à créer ici au fil du codage, en ajoutant « [inductif] » à leur nom, et à consigner dans la piste d'audit avec l'entretien qui les a fait naître."
    },
    {
      "id": "r00013",
      "targetType": "code",
      "targetId": "r00008",
      "created": "2026-10-03T02:09:25.565Z",
      "title": "Définition — 2. Pratiques techniques déclarées",
      "text": "Concept (Tableau III) : Pratiques techniques déclarées\nDéfinition retenue : Réalisation matérielle du dépistage telle que décrite\nDimensions explorées : Systématicité ; gestes et outils ; orientation des cas détectés\nManifestations attendues : Descriptions de séquences ; mention d'outils ; récits de cas\nSource : Guide, axe 1 (Q1-Q3) ; observation A, B, D\n\nCodes inductifs : à créer ici au fil du codage, en ajoutant « [inductif] » à leur nom, et à consigner dans la piste d'audit avec l'entretien qui les a fait naître."
    },
    {
      "id": "r00021",
      "targetType": "code",
      "targetId": "r00014",
      "created": "2026-10-03T02:09:25.565Z",
      "title": "Définition — 3. Pratique informative et éducative",
      "text": "Concept (Tableau III) : Pratique informative et éducative\nDéfinition retenue : Ce qui est transmis à la femme, fondement de sa capacité à agir\nDimensions explorées : Explication de la mesure ; restitution d'un résultat anormal ; risque au-delà de la grossesse ; modulation selon les femmes\nManifestations attendues : Récits d'échanges ; formulations rapportées ; réserves sur le temps disponible ; distinctions entre patientes\nSource : Guide, axe 1 (Q4-Q6) ; observation C (supports uniquement)\n\nCodes inductifs : à créer ici au fil du codage, en ajoutant « [inductif] » à leur nom, et à consigner dans la piste d'audit avec l'entretien qui les a fait naître."
    },
    {
      "id": "r00026",
      "targetType": "code",
      "targetId": "r00022",
      "created": "2026-10-03T02:09:25.565Z",
      "title": "Définition — 4. Conditions individuelles et professionnelles",
      "text": "Concept (Tableau III) : Conditions individuelles\nDéfinition retenue : Éléments relevant de la personne du professionnel\nDimensions explorées : Formation ; sentiment de compétence ; expérience\nManifestations attendues : Références à des formations ; assurance ou doute\nSource : Guide, axe 2 (Q15)\n\nCodes inductifs : à créer ici au fil du codage, en ajoutant « [inductif] » à leur nom, et à consigner dans la piste d'audit avec l'entretien qui les a fait naître."
    },
    {
      "id": "r00032",
      "targetType": "code",
      "targetId": "r00027",
      "created": "2026-10-03T02:09:25.565Z",
      "title": "Définition — 5. Conditions organisationnelles",
      "text": "Concept (Tableau III) : Conditions organisationnelles\nDéfinition retenue : Éléments relevant du fonctionnement du service\nDimensions explorées : Charge ; équipements et consommables ; flux ; supervision\nManifestations attendues : Récits de contraintes matérielles et temporelles\nSource : Guide, axe 2 (Q9, Q10, Q16) ; observation A, B, C\n\nCodes inductifs : à créer ici au fil du codage, en ajoutant « [inductif] » à leur nom, et à consigner dans la piste d'audit avec l'entretien qui les a fait naître."
    },
    {
      "id": "r00037",
      "targetType": "code",
      "targetId": "r00033",
      "created": "2026-10-03T02:09:25.565Z",
      "title": "Définition — 6. Conditions systémiques et politiques",
      "text": "Concept (Tableau III) : Conditions systémiques\nDéfinition retenue : Éléments relevant du système et des politiques\nDimensions explorées : Directives ; programmes ; coordination ; circuit de référence\nManifestations attendues : Références à des directives ; récits de référence\nSource : Guide, axe 2 (Q13, Q16)\n\nCodes inductifs : à créer ici au fil du codage, en ajoutant « [inductif] » à leur nom, et à consigner dans la piste d'audit avec l'entretien qui les a fait naître."
    },
    {
      "id": "r00044",
      "targetType": "code",
      "targetId": "r00038",
      "created": "2026-10-03T02:09:25.565Z",
      "title": "Définition — 7. Conditions sociales perçues (représentations professionnelles)",
      "text": "Concept (Tableau III) : Conditions sociales perçues\nDéfinition retenue : Représentations de la situation sociale des femmes dépistées et incidence déclarée sur la pratique\nDimensions explorées : Moyens et coût ; distance ; assurance ; instruction ; marge de décision ; croyances\nManifestations attendues : Distinctions entre catégories de patientes ; justifications d'un renoncement ; récits de non-retour ; impuissance ou adaptation\nSource : Guide, axe 2 (Q11-Q14)\n\nCodes inductifs : à créer ici au fil du codage, en ajoutant « [inductif] » à leur nom, et à consigner dans la piste d'audit avec l'entretien qui les a fait naître."
    },
    {
      "id": "r00052",
      "targetType": "code",
      "targetId": "r00045",
      "created": "2026-10-03T02:09:25.565Z",
      "title": "Définition — 8. Portée reconnue en équité",
      "text": "Concept (Tableau III) : Portée reconnue en équité\nDéfinition retenue : Appréciation du caractère équitable de la distribution effective du dépistage et jugement porté sur elle\nDimensions explorées : Perception d'un accès différencié ; caractère acceptable ou non ; attribution de responsabilité ; marge d'action\nManifestations attendues : Formulations évaluatives sur le normal et l'anormal ; regret, résignation ou révolte\nSource : Guide, axe 3 (Q19) ; recoupement Q11-Q14\n\nCodes inductifs : à créer ici au fil du codage, en ajoutant « [inductif] » à leur nom, et à consigner dans la piste d'audit avec l'entretien qui les a fait naître."
    },
    {
      "id": "r00059",
      "targetType": "code",
      "targetId": "r00053",
      "created": "2026-10-03T02:09:25.565Z",
      "title": "Définition — 9. Transformations proposées",
      "text": "Concept (Tableau III) : Transformations proposées\nDéfinition retenue : Modifications jugées nécessaires\nDimensions explorées : Priorités formulées ; destinataires désignés\nManifestations attendues : Formulations prescriptives ; hiérarchisation spontanée\nSource : Guide, axe 3 (Q17, Q18)\n\nCodes inductifs : à créer ici au fil du codage, en ajoutant « [inductif] » à leur nom, et à consigner dans la piste d'audit avec l'entretien qui les a fait naître."
    },
    {
      "id": "r00071",
      "targetType": "project",
      "targetId": null,
      "title": "Note de positionnalité — à rédiger AVANT le codage",
      "text": "Confirmabilité (annexe 8 : « journal réflexif et note de positionnalité »).\nPremier temps, avant le codage ; second temps, à la fin de l'analyse. À dater.\n\n1. Qui je suis dans cette étude (COREQ 1-5) : formation, profession, sexe,\n   âge, expérience de la recherche qualitative.\n2. Ma relation au terrain et aux participants (COREQ 6-8) : ce qu'ils\n   savaient de moi, ce qu'ils ont pu supposer, mes liens avec le district.\n3. Ce que je pense trouver : mes présupposés, avant la collecte.\n4. Ce que je fais pour contenir ces influences.\n5. (À la fin de l'analyse) Ce que ma position a produit, d'après mon journal.",
      "created": "2026-10-03T02:09:25.565Z"
    },
    {
      "id": "r00072",
      "targetType": "project",
      "targetId": null,
      "title": "Phase 1 — Familiarisation (journal)",
      "text": "Lecture et relecture des transcriptions ; premières idées notées, sans coder. Une entrée par séance, datée.",
      "created": "2026-10-03T02:09:25.565Z"
    },
    {
      "id": "r00073",
      "targetType": "project",
      "targetId": null,
      "title": "Contrôle de fidélité des transcriptions (§ 4.2.6)",
      "text": "Sondages de la transcription en kinyarwanda contre l'enregistrement ; vérification de la traduction ; passages discutés et décisions.",
      "created": "2026-10-03T02:09:25.565Z"
    },
    {
      "id": "r00074",
      "targetType": "project",
      "targetId": null,
      "title": "Phase 2 — Codage initial",
      "text": "Codage avec la grille déductive ; création des codes inductifs (marqués « [inductif] ») ; chaque création consignée dans la piste d'audit.",
      "created": "2026-10-03T02:09:25.565Z"
    },
    {
      "id": "r00075",
      "targetType": "project",
      "targetId": null,
      "title": "Phase 3 — Recherche des thèmes",
      "text": "Regroupement des codes en thèmes candidats ; carte des thèmes.",
      "created": "2026-10-03T02:09:25.565Z"
    },
    {
      "id": "r00076",
      "targetType": "project",
      "targetId": null,
      "title": "Phase 4 — Revue des thèmes",
      "text": "Chaque thème confronté aux extraits codés, puis au corpus entier ; thèmes fusionnés, scindés ou écartés, avec la raison.",
      "created": "2026-10-03T02:09:25.565Z"
    },
    {
      "id": "r00077",
      "targetType": "project",
      "targetId": null,
      "title": "Phase 5 — Définition et dénomination des thèmes",
      "text": "Pour chaque thème : ce qu'il est, ce qu'il n'est pas, les codes qui le composent, l'objectif spécifique auquel il répond.",
      "created": "2026-10-03T02:09:25.565Z"
    },
    {
      "id": "r00078",
      "targetType": "project",
      "targetId": null,
      "title": "Phase 6 — Production du rapport",
      "text": "Plan du chapitre Résultats ; règles de citation (code du participant et une seule caractéristique ; consentements à respecter).",
      "created": "2026-10-03T02:09:25.565Z"
    },
    {
      "id": "r00079",
      "targetType": "project",
      "targetId": null,
      "title": "Double codage et stabilité intra-codeur",
      "text": "Un tiers des entretiens recodés par un second codeur (étiquette C2) ; recodage par le premier codeur à distance (C1b) ; coefficients κ (Analyse ▸ Accord inter-codeurs) et discussion des désaccords.",
      "created": "2026-10-03T02:09:25.565Z"
    },
    {
      "id": "r00080",
      "targetType": "project",
      "targetId": null,
      "title": "Triangulation",
      "text": "Confrontation des propos, des observations et des données de routine ; écarts ET concordances consignés, sans imputer un écart à une intention.",
      "created": "2026-10-03T02:09:25.565Z"
    },
    {
      "id": "r00081",
      "targetType": "project",
      "targetId": null,
      "title": "Vérification des interprétations auprès des participants",
      "text": "Résumé des thèmes adressé aux participants qui l'ont accepté ; réponses consignées telles quelles, y compris les désaccords.",
      "created": "2026-10-03T02:09:25.565Z"
    },
    {
      "id": "r00082",
      "targetType": "project",
      "targetId": null,
      "title": "Suffisance informationnelle — dimension par dimension (§ 4.2.3.1)",
      "text": "Pour chacune des neuf dimensions du cadre : suffisante ou non, et pourquoi. La collecte se poursuit tant qu'une dimension reste faiblement renseignée.",
      "created": "2026-10-03T02:09:25.565Z"
    },
    {
      "id": "r00083",
      "targetType": "project",
      "targetId": null,
      "title": "Piste d'audit — décisions de codage",
      "text": "Chaque décision datée : code créé, fusionné, renommé ou supprimé ; extrait qui l'a motivée.",
      "created": "2026-10-03T02:09:25.565Z"
    }
  ],
