# ---------------------------------------------------------------------
# NOVA PHARMA OS — configuration de l'API
# ---------------------------------------------------------------------

NODE_ENV=development
PORT=3001
API_PREFIX=api

# Base de données. L'application se connecte avec un rôle SANS BYPASSRLS :
# les politiques Row-Level Security s'appliquent à toutes ses requêtes.
DATABASE_URL=postgresql://nova_app:nova_app@localhost:5432/nova_dev
# Rôle propriétaire, utilisé uniquement par les migrations.
DATABASE_ADMIN_URL=postgresql://postgres@localhost:5432/nova_dev
DATABASE_POOL_MAX=20

# Authentification
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Facturation SaaS
BILLING_DEFAULT_CURRENCY=USD
BILLING_GRACE_DAYS=7

# Tâches planifiées (facturation, relances, suspensions, alertes)
SCHEDULER_ENABLED=true

# Origines autorisées pour le front
CORS_ORIGINS=http://localhost:3000
